{
  "name": "hive",
  "version": "0.1.0",
  "private": true,
  "description": "P2P co-stream source sharing for OBS",
  "main": "out/main/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:spout": "electron tests/electron/spout-roundtrip.mjs",
    "build:viewer": "vite build -c vite.viewer.config.ts",
    "build": "electron-vite build && npm run build:viewer",
    "dev": "npm run build:viewer && electron-vite dev",
    "start": "npm run build && electron-vite preview --skipBuild",
    "fetch:cloudflared": "node scripts/fetch-cloudflared.mjs",
    "predev": "npm run fetch:cloudflared",
    "dist": "npm run fetch:cloudflared && npm run build && electron-builder --win"
  },
  "dependencies": {
    "@napolab/texture-bridge-core": "0.15.0",
    "@napolab/texture-bridge-renderer": "0.15.0",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/ws": "8.18.1",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  }
}
